#!/usr/bin/env python3
"""Opens Claude Code in this terminal as one of your accounts.

Usage: claude-as TAG [any claude arguments]     for example: claude-as claude-b
The chat uses that account's own sign-in and the shared chat history, like claude-ask does.
"""
import json
import os
import sys
from pathlib import Path

CONFIG = Path.home() / ".claude-accounts" / "config.json"
INHERITED = ("CLAUDE", "ANTHROPIC", "USE_LOCAL_OAUTH", "USE_STAGING_OAUTH")


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    tag = sys.argv[1]
    account = json.loads(CONFIG.read_text())["accounts"].get(tag)
    if account is None:
        sys.exit(f"claude-as: no account {tag!r} in {CONFIG}")
    # Drop any sign-in details inherited from another Claude, so only this account's own is used.
    env = {k: v for k, v in os.environ.items() if not k.startswith(INHERITED)}
    env["CLAUDE_CONFIG_DIR"] = os.path.expanduser(account["configDir"])
    os.execvpe("claude", ["claude", *sys.argv[2:]], env)


if __name__ == "__main__":
    main()
