#!/usr/bin/env python3
"""Sends one message to the account that does the work, in a project folder, and prints its reply.

The secondary account does the work (set it with claude-use). With no secondary, or when the
secondary is the account the desktop app is signed in to, a desktop chat is told to do the task
itself (exit code 3), so no account is spent twice; from a terminal, the primary does it.

Each folder keeps ONE chat that every account shares: their chat history folders all point at
~/.claude-accounts/shared, so after a switch the next account picks up the same chat with
nothing lost. (It re-reads the whole chat once, which costs that account a bit more.)

Usage: claude-ask [--new] [--account TAG] FOLDER MESSAGE...
       claude-ask --which FOLDER     prints who a message would go to ("here" or a tag), and the project
  --new      start that folder's chat over
  --account  use this account for this one message
Exit code 3: do this task in the desktop chat itself.
"""
import argparse
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import claude_accounts_lib as lib  # noqa: E402

CHATS = lib.ROOT / "chats"
HANDED_OVER = (
    "This request was handed to you by claude-ask: you are the account doing the work. "
    "Do the work yourself, and never pass it on with claude-ask."
)
DO_IT_HERE = (
    "No other account to hand this to: {why}. Do this task here, in the desktop chat, "
    "and do not call claude-ask for it."
)


def project_for(config, folder):
    best = (None, -1)
    for name, project in config.get("projects", {}).items():
        for raw in project.get("folders", []):
            root = lib.expand(raw)
            if (folder == root or folder.startswith(root + os.sep)) and len(root) > best[1]:
                best = (name, len(root))
    return best[0]


def record_context(reply):
    """Background chats have no live context figure: work it out from the last model call of this run."""
    calls = (reply.get("usage") or {}).get("iterations") or []
    windows = [model.get("contextWindow") for model in (reply.get("modelUsage") or {}).values() if model.get("contextWindow")]
    status_file = lib.STATUS / f"{reply.get('session_id')}.json"
    if not calls or not windows or not status_file.exists():
        return
    last = calls[-1]
    tokens = last.get("input_tokens", 0) + last.get("cache_read_input_tokens", 0) + last.get("cache_creation_input_tokens", 0)
    status = json.loads(status_file.read_text())
    status["context"] = {"percent": round(tokens * 100 / max(windows)), "tokens": tokens, "window": max(windows)}
    status_file.write_text(json.dumps(status, indent=2) + "\n")


def read_chat(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--new", action="store_true")
    parser.add_argument("--account")
    parser.add_argument("--which", action="store_true")
    parser.add_argument("folder")
    parser.add_argument("message", nargs="*")
    args = parser.parse_args()

    config = lib.load()
    folder = os.path.abspath(lib.expand(args.folder))
    if not os.path.isdir(folder):
        sys.exit(f"claude-ask: no such folder: {folder}")
    project = project_for(config, folder) or "other"

    if args.account:
        if args.account not in config["accounts"]:
            sys.exit(f"claude-ask: no account {args.account!r} in {lib.CONFIG}")
        tag = None if lib.is_app_account(config, args.account) else args.account
        why = f"{args.account} is the account this app is signed in to"
    else:
        tag = lib.worker(config)
        why = "no secondary account is set" if not config.get("secondary") else (
            f"the secondary ({config['secondary']}) is the account this app is signed in to")

    if args.which:
        print(f"{tag or 'here'} {project}")
        return
    if not args.message:
        sys.exit("claude-ask: a message is required")
    if tag is None:
        if lib.in_desktop_chat():
            print(DO_IT_HERE.format(why=why), file=sys.stderr)
            sys.exit(3)
        sys.exit("claude-ask: no accounts yet. Add one with: claude-accounts-add TAG EMAIL --primary")

    account = config["accounts"][tag]
    env = lib.clean_env(account)
    # A worker waits for its own background helpers instead of stopping them after 10 minutes.
    env["CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS"] = os.environ.get("CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS", "0")

    CHATS.mkdir(parents=True, exist_ok=True)
    chat_file = CHATS / f"{hashlib.sha1(folder.encode()).hexdigest()[:16]}.json"
    chat = {} if args.new else read_chat(chat_file)
    switched = chat.get("account") not in (None, tag)

    command = [
        "claude", "-p", "--output-format", "json",
        "--permission-mode", account.get("permissionMode", "auto"),
        "--append-system-prompt", HANDED_OVER,
    ]
    if chat.get("sessionId"):
        command += ["--resume", chat["sessionId"]]
    command.append(" ".join(args.message))

    run = subprocess.run(command, cwd=folder, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
    try:
        reply = json.loads(run.stdout)
    except ValueError:
        sys.stdout.write(run.stdout.decode(errors="replace"))
        sys.exit(run.returncode or 1)

    record_context(reply)
    if reply.get("session_id"):
        chat_file.write_text(json.dumps({
            "folder": folder,
            "project": project,
            "sessionId": reply["session_id"],
            "account": tag,
            "updatedAt": int(time.time()),
        }, indent=2) + "\n")
    print(("ERROR: " if reply.get("is_error") else "") + str(reply.get("result", "")))
    note = f" · picked up from {chat['account']}" if switched else ""
    print(f"[{tag} · {project} · chat {str(reply.get('session_id', ''))[:8]}{note}]", file=sys.stderr)
    sys.exit(1 if reply.get("is_error") else 0)


if __name__ == "__main__":
    main()
