#!/usr/bin/env python3
"""Shows and changes which Claude account is primary and which is secondary.

  primary    the account the Claude desktop app is signed in to
  secondary  the account that does all the work. Off: the primary does everything itself.

Usage: claude-use                     lists the accounts, their roles and their 5-hour and weekly use
       claude-use --secondary TAG     TAG does all the work from now on
       claude-use --secondary off     no secondary: the desktop chat does everything itself
       claude-use --primary TAG       TAG is the account the desktop app is signed in to
       claude-use --swap              primary and secondary trade places
       claude-use --best              the signed-in non-primary account with the most room becomes the secondary
       claude-use --who               prints who does the work for this chat: "here" or the secondary's tag
       claude-use TAG                 the same as --secondary TAG
After --primary or --swap, sign the desktop app in to the new primary so the two match.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import claude_accounts_lib as lib  # noqa: E402


def describe(limits):
    if not limits:
        return "no reading yet"
    return f"5h {round(limits.get('five_hour', 0))}% · week {round(limits.get('seven_day', 0))}%"


def show(config):
    limits = lib.latest_limits()
    if not config["accounts"]:
        print('No accounts yet. Add one with:  claude-accounts-add TAG EMAIL --primary')
        return
    for tag, account in config["accounts"].items():
        print(f"{tag:<10} {account.get('email', ''):<30} {describe(limits.get(tag)):<22} {lib.role(config, tag)}")
    worker = lib.worker(config)
    print()
    print("Work goes to: " + ("this desktop chat itself (the primary)" if worker is None else worker))


def warn_mismatch(config):
    """Inside a desktop chat, say when the app is signed in to an account other than the primary."""
    email, primary = lib.app_email(), config.get("primary")
    if not email or not primary or lib.email_of(config, primary) in ("", email):
        return
    match = next((tag for tag in config["accounts"] if lib.email_of(config, tag) == email), None)
    hint = f"claude-use --primary {match}" if match else "claude-accounts-add TAG EMAIL --primary"
    print(f"Note: this app is signed in to {email}, but the primary is {primary}. To match it, run: {hint}")


def require(config, tag):
    if tag not in config["accounts"]:
        sys.exit(f"claude-use: no account {tag!r}. Known: {', '.join(config['accounts']) or 'none yet'}")


def pick_best(config):
    limits = lib.latest_limits()
    others = [tag for tag in config["accounts"] if tag != config.get("primary")]
    ranked = sorted(others, key=lambda tag: max(limits.get(tag, {}).values(), default=0))
    tag = next((t for t in ranked if lib.signed_in(config["accounts"][t])), None)
    if tag is None:
        sys.exit("claude-use: no signed-in account other than the primary.")
    return tag


def set_secondary(config, tag):
    require(config, tag)
    if tag == config.get("primary"):
        sys.exit(f"claude-use: {tag} is the primary. To have the primary do everything: claude-use --secondary off")
    if not lib.signed_in(config["accounts"][tag]):
        sys.exit(f"claude-use: {tag} is not signed in. Run: CLAUDE_CONFIG_DIR={config['accounts'][tag]['configDir']} claude auth login")
    config["secondary"] = tag
    print(f"Secondary: {tag}. It does all the work from now on.")


def main():
    config = lib.load()
    args = sys.argv[1:]
    command = args[0] if args else "--list"
    value = args[1] if len(args) > 1 else None

    if command == "--list":
        show(config)
        warn_mismatch(config)
        return
    if command == "--who":
        print(lib.worker(config) or "here")
        return
    if command in ("-h", "--help"):
        print(__doc__)
        return

    if command == "--swap":
        if not config.get("secondary"):
            sys.exit("claude-use: there is no secondary to swap with.")
        config["primary"], config["secondary"] = config["secondary"], config.get("primary")
        print(f"Primary: {config['primary']}. Secondary: {config['secondary']}.")
        print(f"Now sign the desktop app in to {lib.email_of(config, config['primary']) or config['primary']}.")
    elif command == "--primary" and value:
        require(config, value)
        config["primary"] = value
        if config.get("secondary") == value:
            config["secondary"] = None
        print(f"Primary: {value}. Sign the desktop app in to {lib.email_of(config, value) or value} if it is not already.")
    elif command == "--secondary" and value in ("off", "none"):
        config["secondary"] = None
        print("Secondary: off. The desktop chat does all the work itself, on the primary.")
    elif command == "--secondary" and value:
        set_secondary(config, value)
    elif command == "--best":
        set_secondary(config, pick_best(config))
    elif not command.startswith("-"):
        set_secondary(config, command)
    else:
        sys.exit(__doc__)

    lib.save(config)
    secondary = config.get("secondary")
    if secondary and lib.is_app_account(config, secondary):
        print(f"Note: {secondary} is the account this app is signed in to, so this chat does the work itself.")
    warn_mismatch(config)


if __name__ == "__main__":
    main()
